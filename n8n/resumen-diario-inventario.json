{
  "name": "resumen-diario-inventario",
  "nodes": [
    {
      "parameters": {
        "cronExpression": "0 6 * * *",
        "timezone": "America/Bogota"
      },
      "type": "n8n-nodes-base.cron",
      "position": [
        100,
        0
      ],
      "name": "Programador 6:00 am"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "mcp_base_url",
              "value": "http://localhost:8081"
            },
            {
              "name": "mcp_username",
              "value": "agente_user"
            },
            {
              "name": "mcp_password",
              "value": "admin123"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "position": [
        300,
        0
      ],
      "name": "Config MCP"
    },
    {
      "parameters": {
        "resources": [
          {
            "resource": "executeAPI",
            "operation": "post"
          }
        ],
        "url": "={{$node[\"Config MCP\"].json[\"mcp_base_url\"]}}/tools/consultar_kpis",
        "method": "GET",
        "authentication": "none",
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        500,
        0
      ],
      "name": "consultar_kpis"
    },
    {
      "parameters": {
        "resources": [
          {
            "resource": "executeAPI",
            "operation": "post"
          }
        ],
        "url": "={{$node[\"Config MCP\"].json[\"mcp_base_url\"]}}/tools/consultar_productos_en_riesgo",
        "method": "GET",
        "authentication": "none",
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        500,
        200
      ],
      "name": "consultar_productos_en_riesgo"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$node[\"consultar_productos_en_riesgo\"].json.length > 0}}",
              "operation": "true"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "position": [
        700,
        100
      ],
      "name": "¿Hay productos en riesgo?"
    },
    {
      "parameters": {
        "resources": [
          {
            "resource": "executeAPI",
            "operation": "post"
          }
        ],
        "url": "={{$node[\"Config MCP\"].json[\"mcp_base_url\"]}}/tools/crear_orden_borrador",
        "method": "POST",
        "authentication": "none",
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "bodyContent": "json",
          "jsonParameters": true,
          "rawBody": "={\n  \"productoId\": {{ $node[\"consultar_productos_en_riesgo\"].json[0].productoId }},\n  \"proveedorId\": {{ $node[\"consultar_productos_en_riesgo\"].json[0].proveedorId || null }},\n  \"bodegaDestinoId\": {{ $node[\"consultar_productos_en_riesgo\"].json[0].bodegaDestinoId }},\n  \"cantidad\": {{ Math.ceil(Math.max(1, ($node[\"consultar_productos_en_riesgo\"].json[0].puntoReorden * 2) - $node[\"consultar_productos_en_riesgo\"].json[0].stockTotal)) }},\n  \"precioUnitario\": {{ $node[\"consultar_productos_en_riesgo\"].json[0].precioUnitario || 0 }}\n}"
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        900,
        0
      ],
      "name": "crear_orden_borrador"
    },
    {
      "parameters": {
        "resources": [
          {
            "resource": "executeAPI",
            "operation": "post"
          }
        ],
        "url": "={{$node[\"Config MCP\"].json[\"mcp_base_url\"]}}/tools/publicar_resumen",
        "method": "POST",
        "authentication": "none",
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "bodyContent": "json",
          "jsonParameters": true,
          "rawBody": "={\n  \"fecha\": \"{{ $now.format('YYYY-MM-DD', {zone: 'America/Bogota'}) }}\",\n  \"narrativa\": \"{{ $node[\"crear_orden_borrador\"].json.ordenId ? 'Hay productos en riesgo y una orden pendiente de aprobaci\\u00f3n.' : 'No hay productos en riesgo el d\\u00eda de hoy. Inventario estable.' }}\",\n  \"alertas\": {{ $node[\"crear_orden_borrador\"].json.ordenId ? JSON.stringify([{ \"severidad\": \"ALTA\", \"titulo\": \"Producto en riesgo\", \"detalle\": \"Producto \" + $node[\"consultar_productos_en_riesgo\"].json[0].nombre + \" est\\u00e1 por debajo de su punto de reorden.\", \"productoId\": $node[\"consultar_productos_en_riesgo\"].json[0].productoId, \"ordenId\": $node[\"crear_orden_borrador\"].json.ordenId, \"bodegaId\": $node[\"consultar_productos_en_riesgo\"].json[0].bodegaDestinoId }]) : '[]' }},\n  \"accionesSugeridas\": {{ $node[\"crear_orden_borrador\"].json.ordenId ? JSON.stringify([{ \"tipo\": \"REVISAR_ORDEN\", \"descripcion\": \"Revisar la orden \" + $node[\"crear_orden_borrador\"].json.ordenId + \" antes de aprobarla.\", \"ordenId\": $node[\"crear_orden_borrador\"].json.ordenId, \"productoId\": null, \"bodegaId\": null }]) : '[]' }}\n}"
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        900,
        200
      ],
      "name": "publicar_resumen_con_orden"
    },
    {
      "parameters": {
        "resources": [
          {
            "resource": "executeAPI",
            "operation": "post"
          }
        ],
        "url": "={{$node[\"Config MCP\"].json[\"mcp_base_url\"]}}/tools/publicar_resumen",
        "method": "POST",
        "authentication": "none",
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "bodyContent": "json",
          "jsonParameters": true,
          "rawBody": "={\n  \"fecha\": \"{{ $now.format('YYYY-MM-DD', {zone: 'America/Bogota'}) }}\",\n  \"narrativa\": \"No hay productos en riesgo el d\\u00eda de hoy. Inventario estable.\",\n  \"alertas\": [],\n  \"accionesSugeridas\": []\n}"
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        900,
        400
      ],
      "name": "publicar_resumen_sin_orden"
    }
  ],
